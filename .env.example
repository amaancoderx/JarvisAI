# Required: a Gemini API key from https://aistudio.google.com/apikey (Gemma routing and Gemini Live voice)
GEMINI_API_KEY=
# Signs approvals so they cannot be changed after you approve. Any long random string.
APPROVAL_SECRET=

# Vertex AI and Firestore (planner, Computer Use, Search grounding, memory). Uses the Cloud Run service identity.
VERTEX_PROJECT=
VERTEX_LOCATION=global
PLANNER_MODEL=gemini-3.1-flash-lite
FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash

# Google sign-in for Gmail, Calendar and Drive (OAuth broker)
NANGO_SECRET_KEY=
NANGO_HOST=

# WhatsApp through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cloud computer: path to Chromium (set in the Docker image)
CHROME_PATH=
